# ---------------------------------------------------------------------------
# Copiá este archivo como `.env.local` y completá los valores.
# Vite sólo expone al cliente las variables con prefijo VITE_.
# ---------------------------------------------------------------------------

# [OBLIGATORIA para el mapa] Google Maps JavaScript API Key.
# Ver README → "Configurar la Google Maps API Key".
# Si la dejás vacía, la sección de mapa muestra un fallback elegante (no rompe).
VITE_GOOGLE_MAPS_API_KEY=

# [OPCIONAL] Map ID de un estilo creado en Google Cloud → Map Management.
# Si lo definís, Google ignora los estilos JSON locales y usa el estilo en la nube.
VITE_GOOGLE_MAPS_MAP_ID=

# [OPCIONAL] Base URL de tu API real de propiedades.
# Si está vacía, la app usa el dataset mock de src/data/properties.mock.ts
# Ejemplo: https://api.tu-inmobiliaria.com/v1
VITE_PROPERTIES_API_URL=

# [OPCIONAL] Endpoint que recibe los leads del formulario (POST JSON).
# Si está vacío, el envío se simula en cliente (útil para demo/diseño).
# Ejemplo: https://api.tu-inmobiliaria.com/v1/leads
VITE_LEADS_API_URL=
